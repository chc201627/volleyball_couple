{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      "$sessionId": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && (newData.child('schemaVersion').val() === 2 || newData.child('schemaVersion').val() === 3) && newData.child('ownerUid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('ownerUid').val() === auth.uid))",
        ".validate": "$sessionId.length >= 8 && $sessionId.length <= 32 && newData.hasChildren(['schemaVersion', 'ownerUid', 'createdAt', 'structure'])",
        "schemaVersion": { ".validate": "newData.isNumber() && (newData.val() === 2 || newData.val() === 3)" },
        "ownerUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() === now" },
        "structure": {
          ".write": "auth != null && data.parent().child('ownerUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['playersById', 'teamsById', 'groupsById', 'matchesById'])",
          "playersById": {},
          "teamsById": {},
          "groupsById": {},
          "matchesById": {
            "$matchId": {
              ".validate": "newData.hasChildren(['id', 'groupId', 'team1Id', 'team2Id', 'round', 'order']) && newData.child('id').val() === $matchId",
              "id": { ".validate": "newData.isString() && newData.val() === $matchId" },
              "groupId": { ".validate": "newData.isString()" },
              "team1Id": { ".validate": "newData.isString()" },
              "team2Id": { ".validate": "newData.isString() && newData.val() !== newData.parent().child('team1Id').val()" },
              "round": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
              "order": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
              "stageId": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
              "$other": { ".validate": false }
            }
          },
          "format": {
            ".validate": "newData.hasChildren(['version', 'preset', 'stagesById'])",
            "version": { ".validate": "newData.isNumber() && newData.val() === 1" },
            "preset": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "customRules": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "stagesById": {
              "$stageId": {
                ".validate": "newData.hasChildren(['id', 'kind', 'order', 'pointsTo', 'overtime']) && newData.child('id').val() === $stageId",
                "id": { ".validate": "newData.isString() && newData.val() === $stageId" },
                "kind": { ".validate": "newData.isString() && (newData.val() === 'roundRobin' || newData.val() === 'knockout')" },
                "order": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 8" },
                "pointsTo": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 99" },
                "overtime": { ".validate": "newData.isBoolean()" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "results": {
          "$matchId": {
            ".write": "auth != null && newData.exists() && root.child('tournaments/' + $sessionId + '/structure/matchesById/' + $matchId).exists() && (root.child('tournaments/' + $sessionId + '/ownerUid').val() === auth.uid || root.child('tournamentAccess/' + $sessionId + '/members/' + auth.uid + '/status').val() === 'approved')",
            ".validate": "newData.hasChildren(['score1', 'score2', 'status', 'revision', 'updatedBy', 'updatedAt']) && (newData.child('status').val() === 'live' || newData.child('score1').val() !== newData.child('score2').val())",
            "score1": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "score2": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "status": { ".validate": "newData.isString() && (newData.val() === 'live' || newData.val() === 'finished')" },
            "revision": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() === (data.parent().exists() ? data.parent().child('revision').val() + 1 : 1)" },
            "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "updatedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "tournamentAccess": {
      "$sessionId": {
        "members": {
          ".read": "auth != null && root.child('tournaments/' + $sessionId + '/ownerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('tournaments/' + $sessionId + '/ownerUid').val() === auth.uid)",
            ".write": "auth != null && root.child('tournaments/' + $sessionId).exists() && ((auth.uid === $uid && newData.exists() && newData.child('status').val() === 'pending' && (!data.exists() || data.child('status').val() === 'pending' || data.child('status').val() === 'revoked') && !newData.child('decidedAt').exists()) || (root.child('tournaments/' + $sessionId + '/ownerUid').val() === auth.uid && data.exists() && newData.exists() && newData.child('label').val() === data.child('label').val() && newData.child('requestedAt').val() === data.child('requestedAt').val() && ((data.child('status').val() === 'pending' && newData.child('status').val() === 'approved') || ((data.child('status').val() === 'pending' || data.child('status').val() === 'approved') && newData.child('status').val() === 'revoked'))))",
            ".validate": "newData.hasChildren(['label', 'status', 'requestedAt']) && ((newData.child('status').val() === 'pending' && !newData.child('decidedAt').exists()) || ((newData.child('status').val() === 'approved' || newData.child('status').val() === 'revoked') && newData.child('decidedAt').exists()))",
            "label": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
            "status": { ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'revoked')" },
            "requestedAt": { ".validate": "newData.isNumber() && (newData.val() === data.val() || (auth.uid === $uid && newData.val() === now))" },
            "decidedAt": { ".validate": "newData.isNumber() && (newData.val() === data.val() || newData.val() === now)" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
