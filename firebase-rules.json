{
  "rules": {
    "tournaments": {
      "$sessionId": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
        ".validate": "$sessionId.length >= 8 && $sessionId.length <= 32 && newData.hasChildren(['state', 'updatedAt', 'ownerUid'])",
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "state": {
          ".validate": "newData.hasChildren(['teams', 'groups', 'matches', 'players'])"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
